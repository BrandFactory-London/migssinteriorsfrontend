# Wix Headless client ID (self-managed headless project).
# Visitor/member auth needs only the client ID — no secret.
# Server-side only: do NOT prefix with NEXT_PUBLIC_.
WIX_CLIENT_ID=de3201d8-2fc7-48bb-aeb2-0f6a4419a713

# Client portal (server-side only, never NEXT_PUBLIC_).
# A Wix site API key with Wix Data (read) and Media Manager access, so the
# portal can read its admin-only collections and fetch the clients' PDFs.
WIX_API_KEY=
# 32+ random characters; signs the portal's two-hour session cookie.
PORTAL_SESSION_SECRET=

# Google Analytics 4 measurement ID. Public by design — the tag ships in the
# client bundle — hence NEXT_PUBLIC_, unlike the Wix credentials above.
# Left unset locally so development traffic stays out of the client's reports.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Website forms (server-side only, never NEXT_PUBLIC_).
# Notion internal integration key with access to the Contacts CRM database.
# Every enquiry and job application is written there as a new row. Also keys
# the one-time token that lets /thank-you fire the lead conversion.
NOTION_TOKEN=
